      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does the process work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You pay and fill in the intake form. We study your niche and agree the numbers and dates. You send footage. We send your videos on schedule, and we review the numbers together."
          }
        },
        {
          "@type": "Question",
          "name": "Do you guarantee views?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, and anyone who does is guessing. We control the research, the angle, the cut and the delivery dates. We agree what we’ll track at the start and check it together after the first six videos."
          }
        },
        {
          "@type": "Question",
          "name": "How fast is the first video?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Starter is ready in 7 working days after we receive your footage."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to film?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Send raw footage and we do the rest."
          }
        },
        {
          "@type": "Question",
          "name": "What if I need more changes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Starter includes one round per video and Monthly includes two. Extra rounds are quoted per video."
          }
        },
        {
          "@type": "Question",
          "name": "Can I cancel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Starter is a one-time payment. Monthly and Launch have a two-month minimum, then 14 days’ notice."
          }
        },
        {
          "@type": "Question",
          "name": "Who do you work with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coaches and course creators who sell a program and want more booked calls from short video."
          }
        }
      ]
